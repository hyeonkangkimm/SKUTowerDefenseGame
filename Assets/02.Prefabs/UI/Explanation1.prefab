  m_text: "\uAC00\uB137 -\uACE0\uD1B5\uC5D0 \uAC15\uD55C \uC9D1\uCC29\uC744 \uBCF4\uC774\uB294
    \uAC00\uB137\uC740 \uC804\uC704\uC5D0\uC11C \uC801\uADF9\uC801\uC73C\uB85C \uD53C\uD574\uB97C
    \uBC1B\uAC70\uB098 \uD53C\uD574\uB97C \uC785\uD788\uB294 \uAC78 \uC990\uAE30\uB294
    \uC2E4\uD5D8\uCCB4\uC785\uB2C8\uB2E4. \uB300\uC0C1\uACFC \uC790\uC2E0\uC744 \uC544\uC774\uC5B8
