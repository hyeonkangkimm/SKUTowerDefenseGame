  m_text: "\uB9C8\uB97C\uB80C - \uB9C8\uB97C\uB80C\uC740 \uC5F4\uC815\uC801\uC774\uACE0
    \uC9C1\uC124\uC801\uC778 \uC131\uACA9\uC758 \uC30D\uB465\uC774 \uC790\uB9E4 \uC911
